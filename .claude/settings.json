{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./.backoffice/**)",
      "Edit(./.backoffice/**)",
      "Write(./.backoffice/**)",
      "Bash(git push:*)",
      "Bash(gh pr merge:*)",
      "Bash(curl:*)",
      "Bash(wget:*)"
    ]
  },
  "enabledMcpjsonServers": ["backoffice"],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Write|Edit|MultiEdit|NotebookEdit|Glob|Grep|Bash|WebFetch",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/bin/backoffice hook pre-tool-use" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|Bash|mcp__backoffice__propose_action",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/bin/backoffice hook post-tool-use" }
        ]
      }
    ]
  }
}
