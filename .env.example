# Copy to .env (never commit it) or set in your service manager.
# Claude credentials for headless runs - one of:
ANTHROPIC_API_KEY=
# CLAUDE_CODE_OAUTH_TOKEN=        # from `claude setup-token` (subscription plans)

# Telegram approvals + notifications (approvals.channel / notify.channel = telegram)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_APPROVER_IDS=            # comma-separated Telegram user ids allowed to approve

# Only needed if you enable the slack.post action
SLACK_WEBHOOK_URL=
